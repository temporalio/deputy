# Example Deputy Configuration File
#
# Copy this file to one of:
#   - .deputy.yaml (current directory)
#   - deputy.yaml (current directory)
#   - ~/.deputy.yaml (home directory)
#
# Or set DEPUTY_CONFIG=/path/to/config.yaml
#
# Configuration precedence (highest to lowest):
#   1. Command-line flags
#   2. Environment variables (DEPUTY_*)
#   3. Configuration file
#   4. Built-in defaults

# Logging configuration
logging:
  # Log level: debug, info, warn, error
  # Default: info
  # Env var: DEPUTY_LOG_LEVEL
  level: info

  # Output format: text, json
  # Default: text
  # Env var: DEPUTY_LOG_FORMAT
  format: text

  # Enable ANSI color codes in text format
  # Default: auto-detected (true if stdout is a terminal)
  # Env var: DEPUTY_LOG_COLOR
  color: true

  # Include source file and line numbers in logs
  # Default: false
  # Env var: DEPUTY_LOG_SOURCE
  source: false

# Proxy server configuration (for `deputy proxy` command)
proxy:
  # Address to bind the proxy server
  # Default: :8080
  # Env var: DEPUTY_PROXY_ADDR
  listen_addr: ":8080"

  # Policy files to enforce during proxying
  # Default: none
  # Env var: DEPUTY_PROXY_POLICIES (comma-separated)
  policy_paths:
    - policy/examples/block-high-severity.yaml
    - policy/examples/advisory-all.yaml

# Scanning configuration (for `deputy scan` command)
scan:
  # Limit scanning to specific ecosystems
  # Default: all ecosystems
  # Env var: DEPUTY_SCAN_ECOSYSTEMS (comma-separated)
  ecosystems:
    - npm
    - pypi
    - go
    - rubygems

  # Disable result caching
  # Default: false
  # Env var: DEPUTY_SCAN_SKIP_CACHE
  skip_cache: false

# Policy configuration
policy:
  # Paths to policy files or directories
  # Default: none
  # Env var: DEPUTY_POLICY_PATHS (comma-separated)
  paths:
    - policy/
    - .deputy/policies/

  # Default policy mode: enforce, advisory
  # Default: enforce
  # Env var: DEPUTY_POLICY_MODE
  mode: enforce
